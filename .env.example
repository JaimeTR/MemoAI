# DevmarkPE Store. Solo los NOMBRES de las variables: los valores van en el hosting (Vercel) o en .env.local.

# Supabase de la tienda: pedidos, clientes, cupones, ajustes y cuentas de cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Panel /admin (pedidos, clientes, cupones, ajustes). Sin esta variable el panel queda cerrado.
ADMIN_PASSWORD=

# ERP Devmark: fuente del catalogo (productos, precios, stock, fotos) y destino de los pedidos.
# Sin las tres, la tienda usa la tabla products de Supabase y no sincroniza pedidos.
ERP_API_URL=
# El mismo valor que TIENDA_SIGNING_SECRET en la API del ERP.
ERP_TIENDA_SECRET=
# Id de la empresa DEVMARK en el ERP.
ERP_EMPRESA_ID=

# Correo de confirmacion de pedido (buzon propio de la tienda). Apagado si falta alguno.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Direccion publica de la tienda, para los enlaces de los correos y el SEO.
SITE_URL=https://devmarkpe.store
