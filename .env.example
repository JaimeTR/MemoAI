# DevmarkPE Store. Solo los NOMBRES de las variables: los valores van en el hosting (Vercel) o en .env.local.

# Supabase de la tienda: pedidos, clientes, cupones, ajustes y cuentas de cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ERP Devmark: es el panel de la tienda. De ahi salen catalogo, cupones y datos de pago (Yape, Plin,
# WhatsApp); alla llegan los pedidos y desde alla se cambia su estado (el ERP avisa a /api/erp/pedidos).
# Sin las tres la tienda funciona con lo que haya en Supabase, sin panel.
ERP_API_URL=
# El mismo valor que TIENDA_SIGNING_SECRET en la API del ERP (firma en los dos sentidos).
ERP_TIENDA_SECRET=
# Id de la empresa DEVMARK en el ERP.
ERP_EMPRESA_ID=

# Correo de confirmacion de pedido (buzon propio de la tienda). Apagado si falta alguno.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Direccion publica de la tienda, para los enlaces de los correos y el SEO.
SITE_URL=https://devmarkpe.store
